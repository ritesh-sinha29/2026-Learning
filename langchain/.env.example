# LangChain Tracing / LangSmith (Optional, set to "true" to enable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=default

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Groq
GROQ_API_KEY=

# Hugging Face
HUGGINGFACEHUB_API_TOKEN=

# Ollama (Optional, default is local)
OLLAMA_HOST=http://localhost:11434

# Qwen / DashScope Configuration
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# Search APIs (Optional)
TAVILY_API_KEY=
SERPER_API_KEY=

